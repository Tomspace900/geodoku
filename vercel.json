{
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in main|develop) exit 1;; *) exit 0;; esac",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/auth/callback/google", "destination": "/app-shell" },
    { "source": "/fr/stats", "destination": "/app-shell" },
    { "source": "/en/stats", "destination": "/app-shell" },
    { "source": "/fr/archive/:path*", "destination": "/app-shell" },
    { "source": "/en/archive/:path*", "destination": "/app-shell" },
    { "source": "/admin/:path*", "destination": "/app-shell" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://e.geodoku.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.convex.cloud wss://*.convex.cloud https://*.convex.site https://e.geodoku.app; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
