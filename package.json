{
  "name": "geodoku",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "volta": {
    "node": "22.19.0"
  },
  "scripts": {
    "dev": "vite --host",
    "convex:dev": "convex dev",
    "build": "pnpm typecheck:app && vite build",
    "build:countries": "tsx --env-file=.env.local scripts/countries/build-countries.ts",
    "analyze:pool": "tsx scripts/local/analyze-pool.ts",
    "analyze:observed": "tsx --env-file=.env.local scripts/local/analyze-observed-difficulty.ts",
    "simulate:scheduling": "tsx scripts/local/simulate-scheduling.ts",
    "simulate:players": "tsx --env-file-if-exists=.env.local scripts/local/simulate-players.ts",
    "export:analytics": "tsx --env-file=.env.local scripts/local/export-analytics.ts",
    "dump:prod": "tsx --env-file-if-exists=.env.local scripts/local/copy-convex-data.ts prod-to-dev",
    "dump:develop": "tsx --env-file-if-exists=.env.local scripts/local/copy-convex-data.ts develop-to-dev",
    "dump:prod-to-develop": "tsx --env-file-if-exists=.env.local scripts/local/copy-convex-data.ts prod-to-develop",
    "seed:grids": "pnpm exec convex run seed:seedHistoricalGrids",
    "wipe:db": "tsx --env-file-if-exists=.env.local scripts/local/wipe-db.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "pnpm check:e2e-convex-url && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:reset": "pnpm wipe:db && pnpm seed:grids && pnpm test:e2e",
    "check:e2e-convex-url": "tsx --env-file-if-exists=.env.local scripts/ci/check-e2e-convex-url.ts",
    "check:bundle": "vite build && tsx scripts/ci/check-bundle-size.ts",
    "check:design-system": "tsx scripts/ci/check-design-system.ts",
    "sync:e2e-convex-url": "./scripts/local/sync-e2e-convex-url.sh",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:convex && pnpm typecheck:e2e && pnpm typecheck:tooling",
    "lint": "biome check . && pnpm typecheck",
    "format": "biome format --write .",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .husky || true"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.3.2",
    "@posthog/react": "^1.10.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.42.1",
    "lucide-react": "^0.460.0",
    "match-sorter": "^8.3.0",
    "posthog-js": "^1.386.1",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.1",
    "tailwind-merge": "^2.6.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "convex-test": "^0.0.54",
    "happy-dom": "^20.11.0",
    "lint-staged": "^17.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.9",
    "world-countries": "^5.1.0"
  }
}
