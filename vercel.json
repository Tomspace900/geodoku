{
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in main|develop) exit 1;; *) exit 0;; esac",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/fr/archive/:path*", "destination": "/app-shell" },
    { "source": "/en/archive/:path*", "destination": "/app-shell" },
    { "source": "/admin/:path*", "destination": "/app-shell" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
